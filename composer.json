{
    "name": "webscraping-ai/webscraping-ai-php",
    "description": "Official PHP client for the WebScraping.AI API — LLM-powered web scraping with rotating proxies and Chromium JavaScript rendering.",
    "license": "MIT",
    "type": "library",
    "keywords": ["webscraping", "scraping", "api", "llm", "crawler", "sdk"],
    "homepage": "https://webscraping.ai",
    "authors": [
        {
            "name": "WebScraping.AI Support",
            "email": "support@webscraping.ai",
            "homepage": "https://webscraping.ai"
        }
    ],
    "support": {
        "email": "support@webscraping.ai",
        "issues": "https://github.com/webscraping-ai/webscraping-ai-php/issues",
        "source": "https://github.com/webscraping-ai/webscraping-ai-php",
        "docs": "https://webscraping.ai/docs"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "WebScrapingAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebScrapingAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
